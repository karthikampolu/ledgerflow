rules_version = '2';

// Reference Firebase Storage rules for LedgerFlow production mode.
// Uploaded receipts/documents live under businesses/{businessId}/... and
// are only accessible to that business's owner.
service firebase.storage {
  match /b/{bucket}/o {
    match /businesses/{businessId}/{allPaths=**} {
      allow read, write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }
  }
}
