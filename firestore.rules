rules_version = '2';

// Reference Firestore security rules for LedgerFlow production (Firebase) mode.
// Each business's financial data is only readable/writable by its owner.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsBusiness(businessId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /businesses/{businessId} {
      allow read, update: if ownsBusiness(businessId);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;

      match /{subcollection}/{docId} {
        allow read, write: if ownsBusiness(businessId);
      }
    }
  }
}
