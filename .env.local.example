# Copy this file to .env.local and fill in your Firebase project's web app
# config (Firebase Console -> Project Settings -> General -> Your apps -> SDK setup).
# Until these are filled in with real values, LedgerFlow automatically runs in
# local demo mode (browser-local storage, seeded with realistic demo data) so
# the full app works with zero setup.

NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
